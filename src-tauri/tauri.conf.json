{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Derivon",
  "version": "0.4.2",
  "identifier": "net.derivon.mindmap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Derivon",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "files": {
          "/usr/share/metainfo/net.derivon.mindmap.metainfo.xml": "../packaging/linux/net.derivon.mindmap.metainfo.xml"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/metainfo/net.derivon.mindmap.metainfo.xml": "../packaging/linux/net.derivon.mindmap.metainfo.xml"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
