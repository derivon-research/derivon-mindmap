{
  "name": "derivon-mindmap",
  "private": true,
  "version": "0.4.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "vite --mode desktop",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:debug": "tauri dev --features debug-tools -- -- --debug",
    "tauri:build": "tauri build",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "test": "tsc --noEmit -p tsconfig.hosts-desktop.json && vitest run src && npm run test:initial-js-budget",
    "test:node": "vitest run --project=node",
    "test:browser": "vitest run --project=browser",
    "test:initial-js-budget": "node --test scripts/check-initial-js-budget.test.mjs",
    "check:initial-js-budget": "node scripts/check-initial-js-budget.mjs",
    "test:e2e": "playwright test",
    "typecheck:perf": "tsc --noEmit -p tsconfig.performance.json",
    "bench:graph": "playwright test --config playwright.performance.config.ts benchmarks/graph-performance.spec.ts",
    "bench:replacement": "playwright test --config playwright.performance.config.ts benchmarks/replacement-performance.spec.ts",
    "bench:runtime": "playwright test --config playwright.performance.config.ts benchmarks/runtime-performance.spec.ts",
    "bench:runtime:desktop": "node --experimental-strip-types benchmarks/desktop-runtime.mjs",
    "bench:rendering": "vitest run --project browser src/rendering/GraphRenderer.browser.test.tsx -t 'generated performance' --reporter verbose",
    "bench:g6-isolated": "playwright test --config playwright.performance.config.ts benchmarks/g6-performance.spec.ts",
    "check:release-version": "node scripts/check-release-version.mjs"
  },
  "dependencies": {
    "@antv/g6": "^5.1.1",
    "@dagrejs/dagre": "^3.1.1",
    "@tauri-apps/api": "^2.11.1",
    "@tiptap/extension-file-handler": "^3.30.3",
    "@tiptap/extension-image": "^3.30.3",
    "@tiptap/extension-list": "^3.30.3",
    "@tiptap/extension-mathematics": "^3.30.3",
    "@tiptap/extension-table": "^3.30.3",
    "@tiptap/markdown": "^3.30.3",
    "@tiptap/pm": "^3.30.3",
    "@tiptap/react": "^3.30.3",
    "@tiptap/starter-kit": "^3.30.3",
    "d3-force": "^3.0.0",
    "fuse.js": "^7.5.0",
    "katex": "^0.18.4",
    "lucide-react": "^0.468.0",
    "marked": "^16.4.2",
    "marked-katex-extension": "^5.1.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-joyride": "^3.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
